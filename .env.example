# Kopyala: cp .env.example .env  — yalnızca yerel geliştirme. Gerçek sır commit edilmez.
POSTGRES_VERSION=17.6-alpine
VALKEY_VERSION=8.1.4-alpine
RABBITMQ_VERSION=4.1.4-management-alpine
MAILPIT_VERSION=v1.27.10

AIH_ENVIRONMENT=local
AIH_DB_PASSWORD=change-me-local
AIH_VALKEY_PASSWORD=change-me-local
AIH_RABBITMQ_PASSWORD=change-me-local

# Host portları — BuildingFlow/TraceFlow ile çakışmaması için 2xxxx bloğu
AIH_DB_HOST_PORT=25432
AIH_VALKEY_HOST_PORT=26379
AIH_RABBITMQ_HOST_PORT=25672
AIH_RABBITMQ_UI_HOST_PORT=25673
AIH_MAILPIT_UI_HOST_PORT=28025
AIH_MAILPIT_SMTP_HOST_PORT=21025

# Kimlik (PHASE-02 dilimi). Dev modu yalnız local/test'te: "X-AIH-Dev-User: <tenant-slug>:<Rol>"
AIH_AUTH_DEV_MODE=false
# Hub API'yi tarayıcıdan çağıracak origin'ler (admin web, BuildingFlow, TraceFlow)
AIH_CORS_ORIGINS=http://localhost:28030

# Secret şifreleme (PHASE-03). Üret: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Biçim: kid:<anahtar>[,eskiKid:<eski-anahtar>] — yerelde boşsa SMTP şifresi kaydedilemez.
AIH_SECRET_KEYS=
# Mailpit gibi yerel SMTP hedefleri için (yalnız local/dev/test)
AIH_SMTP_ALLOW_PRIVATE_HOSTS=true
AIH_SMTP_ALLOWED_PORTS=25,465,587,2525
AIH_SMTP_HOST_ALLOWLIST=
