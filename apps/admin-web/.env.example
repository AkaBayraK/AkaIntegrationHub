# Admin web (tarayıcıya açık değerler — sır yazmayın)
NEXT_PUBLIC_AIH_API_URL=http://localhost:28080
# Hub'a bağlanan uygulamaların Keycloak realm'leri. Her realm'de "aih-admin-web" public client'ı olmalı.
NEXT_PUBLIC_AIH_IDPS=[{"id":"buildingflow","label":"BuildingFlow","issuer":"http://localhost:8080/realms/buildingflow","clientId":"aih-admin-web"},{"id":"traceflow","label":"TraceFlow","issuer":"http://localhost:8081/realms/traceflow-realm","clientId":"aih-admin-web"}]
# "← Uygulamaya dön" bağlantısı için izinli host origin'leri
NEXT_PUBLIC_AIH_HOST_RETURN_ORIGINS=http://localhost:3003,http://localhost:3000
# Yalnız yerel geliştirme (API'de AIH_AUTH_DEV_MODE=true): Keycloak olmadan "<tenant-slug>:<Rol>"
NEXT_PUBLIC_AIH_DEV_USER=
