{
  "name": "@aka/integration-ui",
  "version": "0.1.0",
  "description": "Embeddable React components for Aka Integration Hub",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./styles.css": "./src/styles.css"
  },
  "files": ["dist", "src/styles.css"],
  "sideEffects": ["*.css"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=19.0.0 <20",
    "react-dom": ">=19.0.0 <20"
  },
  "dependencies": {
    "@aka/design-tokens": "0.1.0"
  }
}
