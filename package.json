{
  "name": "aka-integration-hub-web",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["packages/design-tokens", "packages/ui-react", "apps/admin-web"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "npm run build --workspace @aka/integration-ui && npm run build --workspace @aka/admin-web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
